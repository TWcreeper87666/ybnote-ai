# Secrets — never commit
.env
*.env

# Node
node_modules/

# Python
__pycache__/
*.pyc

# Generated/fetched data — regenerable from the scripts, not source
output/*
!output/.gitkeep
input/*
!input/.gitkeep
# Held-out test charts (fetchSupabaseLevels.js --id) and their encodings
input_test/
output_test/
# Generated trail-stroke levels (scripts/generate_trail_levels.py) and
# their encodings — regenerable from the seed
input_synth*/
output_synth*/
# Exported compare bundles / replay zips — regenerable with
# export_compare_bundle.py; only the model lists that drive it are source
replays/*
!replays/models_*.json
# Rendered gameplay videos (scripts/renderVideos.js)
videos/

training/connectome.csv
training/roles.draft.json
training/roles.json
training/skeletons/
training/skeletons.json
training/bundle.json
training/spikes.json
training/replay.json
training/replay_*.json
training/*.pt
training/*.log

# OS
.DS_Store
Thumbs.db

# Local Python environment (CUDA torch)
.venv/
.pip-tmp/
training/*.err
