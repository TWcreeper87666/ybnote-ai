# Secrets — never commit
.env
*.env

# Node
node_modules/

# Python
__pycache__/
*.pyc

# Generated/fetched data (data/) — regenerable from the scripts, not source:
# fetched charts, held-out test charts, synthetic trail levels and encodings
data/*
!data/input/
data/input/*
!data/input/.gitkeep
!data/output/
data/output/*
!data/output/.gitkeep
# Exported compare bundles / replay zips — regenerable with
# export_compare_bundle.py; only the model lists that drive it are source
replays/*
!replays/models_*.json
# Rendered gameplay videos (scripts/renderVideos.js)
videos/
# Report assets (demo GIFs, report figures, the .docx) — regenerate the GIFs and
# figures with scripts/make_approach_gifs.py and scripts/make_report_figures.py
reports/

training/connectome.csv
training/roles.draft.json
training/roles.json
training/skeletons/
training/skeletons.json
training/bundle.json
training/spikes.json
training/replay.json
training/replay_*.json
training/models/
training/logs/

